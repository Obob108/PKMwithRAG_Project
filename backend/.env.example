# Copy this file to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
JWT_SECRET=change-me-to-a-long-random-string
EMBEDDING_MODEL=BAAI/bge-m3
DATA_DIR=../data
# Dang ky tai khoan: dat false de tat; INVITE_CODE khac rong = bat buoc nhap ma moi khi dang ky
ALLOW_REGISTRATION=true
INVITE_CODE=
# hCaptcha (https://dashboard.hcaptcha.com): dat ca hai de bat captcha khi dang nhap/dang ky; de trong = tat.
# Khoa thu cua hCaptcha (luon qua): sitekey 10000000-ffff-ffff-ffff-000000000001, secret 0x0000000000000000000000000000000000000000
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
