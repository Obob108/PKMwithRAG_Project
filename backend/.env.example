# Copy this file to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Model du phong khi model chinh qua tai/het han muc, cach nhau dau phay (xem ten hop le trong Google AI Studio)
# vd: GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=
JWT_SECRET=change-me-to-a-long-random-string
EMBEDDING_MODEL=BAAI/bge-m3
DATA_DIR=../data
# CSDL: de trong = SQLite (DATA_DIR/app.db) + FAISS. PostgreSQL + pgvector (xem docker-compose.yml o thu muc goc):
# DATABASE_URL=postgresql://pkm:pkm@localhost:5433/pkm
DATABASE_URL=
# So ket noi toi da trong connection pool (chi PostgreSQL)
DB_POOL_SIZE=10
# De trong = tu chon: pgvector neu PostgreSQL, faiss neu SQLite
VECTOR_BACKEND=
# Dang ky tai khoan: dat false de tat; INVITE_CODE khac rong = bat buoc nhap ma moi khi dang ky
ALLOW_REGISTRATION=true
INVITE_CODE=
# hCaptcha (https://dashboard.hcaptcha.com): dat ca hai de bat captcha khi dang nhap/dang ky; de trong = tat.
# Khoa thu cua hCaptcha (luon qua): sitekey 10000000-ffff-ffff-ffff-000000000001, secret 0x0000000000000000000000000000000000000000
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
# Email gui ma OTP quen mat khau (Gmail): bat xac minh 2 buoc cho tai khoan Gmail, tao App Password tai
# https://myaccount.google.com/apppasswords roi dan 16 ky tu vao SMTP_PASSWORD. De trong = ma OTP in ra log backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
