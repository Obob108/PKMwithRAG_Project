+    conn.commit()
+    # Go khoa dang nhap sai (neu co) de dang nhap lai duoc ngay bang mat khau moi.
+    request.app.state.login_limiter.reset(f"{key}|{row['username'].lower()}")
+    return {"username": row["username"]}
