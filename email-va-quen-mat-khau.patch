+@router.post("/auth/reset-password")
+def reset_password(body: ResetPasswordRequest, request: Request, conn=Depends(get_conn)):
+    """Quen mat khau: nhap email + mat khau moi, sau do dang nhap lai nhu binh thuong.
+    LUU Y: khong xac minh quyen so huu email (khong gui ma/OTP) -> chi phu hop ban demo."""
+    limiter = request.app.state.reset_limiter
+    key = _client_ip(request)
+    if limiter.blocked(key):
+        raise HTTPException(status_code=429, detail="Đặt lại mật khẩu quá nhiều lần, thử lại sau")
+    limiter.hit(key)
+    email = _gmail(body.email)
+    row = conn.execute("SELECT id, username FROM users WHERE email = ?", (email,)).fetchone()
+    if row is None:
